# Copy to frontend/.env.local for local development. Never commit .env.local.
# Every VITE_* value is inlined into the browser bundle and is public. Do not
# put private keys, RPC API keys, or secrets here.

# Default escrow address shown on the home page. Falls back to the verified
# Sepolia example contract when empty or invalid.
VITE_ESCROW_ADDRESS=0x87Be26BfA7714A1E50aAF60C712f7b3dc3Bc809D

# Optional Sepolia JSON-RPC URL. When empty, the app falls back to the public
# endpoints listed in src/config/wagmi.ts.
VITE_SEPOLIA_RPC_URL=

# Optional WalletConnect Cloud project ID. Without it, only injected wallets
# are offered. This ID is public by design.
VITE_WALLETCONNECT_ID=

# Development only. true targets a local Anvil chain at 127.0.0.1:8545
# (chain 31337) instead of Sepolia. Forced off in production builds.
VITE_ENABLE_LOCAL=false

# Development only. true reveals the /lab design preview and its nav link.
# Forced off in production builds, where /lab is unreachable.
VITE_ENABLE_LAB=false
